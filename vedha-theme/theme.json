{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "vedha-red",
          "color": "#D4161C",
          "name": "Vedha Red"
        },
        {
          "slug": "vedha-green",
          "color": "#14602F",
          "name": "Eco Green"
        },
        {
          "slug": "vedha-green-light",
          "color": "#E8F4ED",
          "name": "Eco Green Light"
        },
        {
          "slug": "vedha-bg-neutral",
          "color": "#FAF9F6",
          "name": "Light Neutral Background"
        },
        {
          "slug": "vedha-surface-white",
          "color": "#FFFFFF",
          "name": "Pure White"
        },
        {
          "slug": "vedha-text-main",
          "color": "#1A1A1A",
          "name": "Main Text"
        },
        {
          "slug": "vedha-text-muted",
          "color": "#5A5A5A",
          "name": "Muted Text"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "manrope",
          "name": "Manrope (Display & Headings)"
        },
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "inter",
          "name": "Inter (Body text)"
        }
      ]
    },
    "layout": {
      "contentSize": "840px",
      "wideSize": "1240px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--vedha-bg-neutral)",
      "text": "var(--wp--preset--color--vedha-text-main)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--manrope)",
          "fontWeight": "700"
        },
        "color": {
          "text": "var(--wp--preset--color--vedha-text-main)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--vedha-green)"
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--manrope)",
          "fontWeight": "700"
        },
        "border": {
          "radius": "10px"
        },
        "color": {
          "background": "var(--wp--preset--color--vedha-green)",
          "text": "#ffffff"
        }
      }
    }
  }
}
